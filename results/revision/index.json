  "hash_policy": {
    "source_sha256": "Original source bytes before portability changes. For listed immutable_archive_sources, this is the original archive-member hash.",
    "destination_sha256": "Exact public-view bytes in this directory; use these hashes to verify Git files.",
    "path_portability": "Only known personal filesystem prefixes are replaced. Generic historical runtime paths are preserved. Numeric scalars retain exact integer values and IEEE754 float bits; structure and nonpath strings are checked.",
    "archive_layout": "Release workspace results/* corresponds to the cited paper experiments/results/*. Project-relative geometry, route and run paths are retained.",
    "coverage": "Original archive coverage is recorded per file. Figure sidecars and local generated summaries without such coverage are published as portable Git views."
  },
  "excluded_artifacts": [
    "full feature catalogues/annotations",
    "raw count matrices",
